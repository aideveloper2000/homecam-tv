<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Leanback browse / playback -->
    <style name="Theme.HomeCamTV" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.HomeCamTV.Playback" parent="Theme.HomeCamTV">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Add / edit camera form -->
    <style name="Theme.HomeCamTV.Form" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:editTextStyle">@style/HomeCamEditText</item>
        <item name="android:buttonStyle">@style/HomeCamButton</item>
        <item name="android:spinnerStyle">@style/HomeCamSpinner</item>
    </style>

    <style name="HomeCamEditText" parent="android:Widget.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="HomeCamButton" parent="android:Widget.Material.Button">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:backgroundTint">@color/brand</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="HomeCamSpinner" parent="android:Widget.Material.Spinner">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

</resources>
